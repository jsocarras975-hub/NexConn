generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  OWNER
  ADMIN
}
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}
enum ProjectStatus {
  INQUIRY
  QUOTED
  ACTIVE
  REVIEW
  COMPLETED
  ON_HOLD
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id           String    @id @default(cuid())
  emailVerificationTokens EmailVerificationToken[]
  emailVerified DateTime?
  passwordResetTokens PasswordResetToken[]
  tokenVersion Int @default(0)
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(CLIENT)
  disabled     Boolean   @default(false)
  stripeCustomerId String? @unique
  subscriptions Subscription[]
  licenses     License[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  projects     Project[] @relation("ClientProjects")
  tickets      Ticket[]
  messages     Message[]
  auditLogs    AuditLog[] @relation("ActorLogs")
  invoices     Invoice[]
  crmLeadsAsCustomer CrmLead[] @relation("CrmLeadCustomer")
  crmLeadsAssigned CrmLead[] @relation("CrmLeadAssignedTo")
  crmLeadsCreated CrmLead[] @relation("CrmLeadCreatedBy")
  crmTasksAsCustomer CrmTask[] @relation("CrmTaskCustomer")
  crmTasksAssigned CrmTask[] @relation("CrmTaskAssignedTo")
  crmTasksCreated CrmTask[] @relation("CrmTaskCreatedBy")
  crmNotesAsCustomer CrmNote[] @relation("CrmNoteCustomer")
  crmNotesAuthored CrmNote[] @relation("CrmNoteAuthor")
  crmCommunicationsAsCustomer CrmCommunication[] @relation("CrmCommunicationCustomer")
  crmCommunicationsAuthored CrmCommunication[] @relation("CrmCommunicationAuthor")
  crmWorkflowsCreated CrmWorkflow[] @relation("CrmWorkflowCreatedBy")
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  summary        String
  description    String   @db.Text
  category       String
  priceCents     Int
  currency       String   @default("usd")
  imageUrl       String?
  downloadKey    String?
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderItems     OrderItem[]
  bundleComponents BundleItem[]    @relation("BundleComponents")
  bundledIn        BundleItem[]    @relation("BundledIn")
  versions         ProductVersion[]
  licenses         License[]
}

// A bundle is a product whose purchase also grants the component products'
// downloads. The bundle product itself may have no file of its own.
model BundleItem {
  id              String  @id @default(cuid())
  bundleProductId String
  bundleProduct   Product @relation("BundleComponents", fields: [bundleProductId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation("BundledIn", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleProductId, productId])
  @@index([productId])
}

// One row per released version of a product's file. Attaching a file with a
// version label records a row here and notifies past buyers.
model ProductVersion {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version     String
  changelog   String?  @db.Text
  downloadKey String
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

// A license key issued for one purchased order item.
model License {
  id          String    @id @default(cuid())
  key         String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([productId])
}

// A discount code. The Stripe coupon is created alongside the local row and
// applied at checkout, so the Stripe total and the local order total agree.
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int?
  amountOffCents Int?
  currency       String    @default("usd")
  active         Boolean   @default(true)
  expiresAt      DateTime?
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  stripeCouponId String?
  createdAt      DateTime  @default(now())

  @@index([active, expiresAt])
}

// The public service catalog. Until 2026-11-26 the catalog lived only as
// the static SERVICES array in src/data/studio.ts; it now lives here so
// the owner can add, edit, deactivate, and delete services from the admin
// panel. src/lib/services.ts reads this table and falls back to the
// static array when the table is empty or unreachable, so the marketing
// pages can never be taken down by a catalog problem. `price` is the
// display string exactly as shown ("$1,250", "$9.99/mo") — catalog prices
// are final prices, never "starting at".
model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  group        String
  price        String
  pitch        String   @db.Text
  deliverables String[]
  sort         Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, sort])
}

// A Stripe subscription for a hosting plan, mirrored locally so the portal
// can show plan and status without calling Stripe on every page load.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, status])
}

model Order {
  id                    String      @id @default(cuid())
  refunds StripeRefund[]
  paidAt DateTime?
  refundedCents Int @default(0)
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status                OrderStatus @default(PENDING)
  subtotalCents         Int
  discountCents         Int         @default(0)
  couponCode            String?
  taxCents              Int         @default(0)
  totalCents            Int
  currency              String      @default("usd")
  stripeCheckoutSession String?     @unique
  stripePaymentIntent   String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceCents  Int
  licenses        License[]

  @@index([orderId])
  @@index([productId])
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation("ClientProjects", fields: [clientId], references: [id])
  title       String
  summary     String
  status      ProjectStatus @default(INQUIRY)
  progress    Int           @default(0)
  budgetCents Int?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    Message[]
  tasks       ProjectTask[]
  invoices    Invoice[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  Message[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([projectId, createdAt])
  @@index([authorId, createdAt])
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  service     String
  budget      String?
  timeline    String?
  details     String   @db.Text
  source      String   @default("website")
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id])
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}


enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
  REFUNDED
}

model ProjectTask {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Invoice {
  id             String        @id @default(cuid())
  stripePaymentIntent String? @unique
  stripeCheckoutSession String? @unique
  invoiceNumber  String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("usd")
  subtotalCents  Int
  taxCents       Int            @default(0)
  totalCents     Int
  refundedCents  Int            @default(0)
  dueAt          DateTime?
  paidAt         DateTime?
  acceptedAt     DateTime?
  depositOfId    String?       @unique
  depositOf      Invoice?      @relation("InvoiceDeposit", fields: [depositOfId], references: [id], onDelete: SetNull)
  deposit        Invoice?      @relation("InvoiceDeposit")
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          InvoiceItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPriceCents Int
}

model BusinessSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
}

model StripeRefund {
  id               String   @id @default(cuid())
  stripeRefundId   String   @unique
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents      Int
  currency         String
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId, createdAt])
}

model CrmLead {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  company            String?
  phone              String?
  source             String   @default("OTHER")
  stage              String   @default("NEW")
  estimatedValueCents Int?
  currency           String   @default("usd")
  customerId         String?
  customer           User?    @relation("CrmLeadCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId       String?
  assignedTo         User?    @relation("CrmLeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?    @relation("CrmLeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks              CrmTask[] @relation("CrmTaskLead")
  notes              CrmNote[] @relation("CrmNoteLead")
  communications     CrmCommunication[] @relation("CrmCommunicationLead")
  nextFollowUpAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([stage, updatedAt])
  @@index([customerId])
  @@index([assignedToId, nextFollowUpAt])
  @@index([createdById])
}

model CrmTask {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("OPEN")
  priority     String   @default("NORMAL")
  dueAt        DateTime?
  customerId   String?
  customer     User?    @relation("CrmTaskCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  leadId       String?
  lead         CrmLead? @relation("CrmTaskLead", fields: [leadId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?    @relation("CrmTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?    @relation("CrmTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, dueAt])
  @@index([customerId])
  @@index([leadId])
  @@index([assignedToId])
  @@index([createdById])
}

model CrmNote {
  id          String   @id @default(cuid())
  body        String
  customerId  String?
  customer    User?    @relation("CrmNoteCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        CrmLead? @relation("CrmNoteLead", fields: [leadId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?    @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([leadId, createdAt])
  @@index([authorId, createdAt])
}

model CrmCommunication {
  id          String   @id @default(cuid())
  channel     String
  direction   String   @default("OUTBOUND")
  subject     String?
  summary     String
  customerId  String?
  customer    User?    @relation("CrmCommunicationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        CrmLead? @relation("CrmCommunicationLead", fields: [leadId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?    @relation("CrmCommunicationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([authorId, occurredAt])
}

model CrmWorkflow {
  id          String   @id @default(cuid())
  name        String
  trigger     String
  action      String
  config      Json
  enabled     Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("CrmWorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  runs        CrmWorkflowRun[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, trigger])
  @@index([createdById])
}

model CrmWorkflowRun {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    CrmWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  dedupeKey   String
  status      String   @default("RUNNING")
  result      Json?
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  @@unique([workflowId, dedupeKey])
  @@index([status, startedAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  country   String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}
