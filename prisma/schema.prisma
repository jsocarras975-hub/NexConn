generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  OWNER
  ADMIN
}
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}
enum ProjectStatus {
  INQUIRY
  QUOTED
  ACTIVE
  REVIEW
  COMPLETED
  ON_HOLD
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id           String    @id @default(cuid())
  emailVerificationTokens EmailVerificationToken[]
  emailVerified DateTime?
  passwordResetTokens PasswordResetToken[]
  tokenVersion Int @default(0)
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(CLIENT)
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  projects     Project[] @relation("ClientProjects")
  tickets      Ticket[]
  messages     Message[]
  auditLogs    AuditLog[] @relation("ActorLogs")
  invoices     Invoice[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  summary        String
  description    String   @db.Text
  category       String
  priceCents     Int
  currency       String   @default("usd")
  imageUrl       String?
  downloadUrl    String?
  downloadKey    String?
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderItems     OrderItem[]
}

model Order {
  id                    String      @id @default(cuid())
  refunds StripeRefund[]
  paidAt DateTime?
  refundedCents Int @default(0)
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                OrderStatus @default(PENDING)
  subtotalCents         Int
  totalCents            Int
  currency              String      @default("usd")
  stripeCheckoutSession String?     @unique
  stripePaymentIntent   String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceCents  Int
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation("ClientProjects", fields: [clientId], references: [id])
  title       String
  summary     String
  status      ProjectStatus @default(INQUIRY)
  progress    Int           @default(0)
  budgetCents Int?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    Message[]
  tasks       ProjectTask[]
  invoices    Invoice[]
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  service     String
  budget      String?
  timeline    String?
  details     String   @db.Text
  source      String   @default("website")
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id])
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}


enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model ProjectTask {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Invoice {
  id             String        @id @default(cuid())
  stripePaymentIntent String? @unique
  stripeCheckoutSession String? @unique
  invoiceNumber  String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("usd")
  subtotalCents  Int
  taxCents       Int            @default(0)
  totalCents     Int
  dueAt          DateTime?
  paidAt         DateTime?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          InvoiceItem[]
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPriceCents Int
}

model BusinessSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
}

model StripeRefund {
  id               String   @id @default(cuid())
  stripeRefundId   String   @unique
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents      Int
  currency         String
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId, createdAt])
}

model CrmLead {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  company            String?
  phone              String?
  source             String   @default("OTHER")
  stage              String   @default("NEW")
  estimatedValueCents Int?
  currency           String   @default("USD")
  customerId         String?
  assignedToId       String?
  createdById        String
  nextFollowUpAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([stage, updatedAt])
  @@index([customerId])
  @@index([assignedToId, nextFollowUpAt])
}

model CrmTask {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("OPEN")
  priority     String   @default("NORMAL")
  dueAt        DateTime?
  customerId   String?
  leadId       String?
  assignedToId String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, dueAt])
  @@index([customerId])
  @@index([leadId])
}

model CrmNote {
  id          String   @id @default(cuid())
  body        String
  customerId  String?
  leadId      String?
  authorId    String
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([leadId, createdAt])
}

model CrmCommunication {
  id          String   @id @default(cuid())
  channel     String
  direction   String   @default("OUTBOUND")
  subject     String?
  summary     String
  customerId  String?
  leadId      String?
  authorId    String
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([leadId, occurredAt])
}

model CrmWorkflow {
  id          String   @id @default(cuid())
  name        String
  trigger     String
  action      String
  config      Json
  enabled     Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, trigger])
}

model CrmWorkflowRun {
  id          String   @id @default(cuid())
  workflowId  String
  dedupeKey   String
  status      String   @default("RUNNING")
  result      Json?
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  @@unique([workflowId, dedupeKey])
  @@index([status, startedAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  country   String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}
