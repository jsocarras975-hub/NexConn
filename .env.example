# Required
DATABASE_URL="postgresql://nexcon:nexcon_dev_password@localhost:5432/nexcon?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"

# Payments (optional until checkout is enabled)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Object storage (optional; configure before enabling customer uploads)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Email provider (optional)
RESEND_API_KEY=""
EMAIL_FROM="NEXCON <hello@example.com>"\nOWNER_EMAIL="owner@example.com"
# Distributed rate limiting (Upstash Redis REST)
# Configure both values in Vercel Project Settings -> Environment Variables.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Protect the scheduled CRM workflow endpoint.
CRON_SECRET=""
# v14.4 launch hardening — new variables.
# Add these to your local .env and Vercel Project Settings -> Environment Variables.
# This file is separate from the v14.3 .env.example.additions so applying
# v14.4 never overwrites the Upstash/CRON entries from v14.3.

# Cloudflare Turnstile (free CAPTCHA). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile — choose the
# "Managed" widget type. The site key is public (NEXT_PUBLIC_); the secret
# key stays server-side and is never committed.
# Without these keys, CAPTCHA is skipped in local development, but in
# production the check fails closed (forms return an error) — set both
# keys in Vercel Production before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
